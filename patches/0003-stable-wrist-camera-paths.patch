+def _wrist_path(which: str) -> str:
+    """Stable path for a wrist camera.
+
+    /dev/videoN is assigned in enumeration order, so re-plugging a camera (or
+    the D455 re-enumerating) silently moved "right" onto the laptop webcam on
+    2026-11-16.  Both wrist cameras are identical Sonix USB2.0_CAM1 units with
+    no serial number, so the only stable identity is the USB port they are
+    plugged into, which is what /dev/v4l/by-path encodes.
+    """
+    candidates = {
+        "left": [
+            "/dev/xlerobot_cam_left",  # optional udev rule
+            "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:1.2:1.0-video-index0",
+        ],
+        "right": [
+            "/dev/xlerobot_cam_right",
+            "/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2.2:1.0-video-index0",
+        ],
+    }[which]
+    for path in candidates:
+        if os.path.exists(path):
+            return path
+    return candidates[0]
+
